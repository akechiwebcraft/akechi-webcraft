# SMTP credentials for the contact form.
# Copy this file to `.env.local` and fill in real values (.env* is gitignored).

# Your mail host. Examples:
#   Hostinger        -> smtp.hostinger.com
#   Google Workspace -> smtp.gmail.com
#   Zoho             -> smtp.zoho.in
SMTP_HOST=smtp.hostinger.com

# 465 = implicit TLS (recommended), 587 = STARTTLS
SMTP_PORT=465

# The mailbox that authenticates and appears as the sender
SMTP_USER=info@akechiwebcraft.com

# The mailbox password. For Google Workspace use an app-specific password
# instead of the account password: https://myaccount.google.com/apppasswords
SMTP_PASS=your-password-here

# Where enquiries are delivered. Defaults to SITE_CONFIG.email if unset.
CONTACT_TO_EMAIL=info@akechiwebcraft.com
